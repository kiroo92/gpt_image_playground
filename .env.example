# 可直接使用 compose.yaml 默认值；需要调整时将本文件复制为 .env。
# 网站地址固定为 https://www.open1.codes/，API Key 在网页中填写。

# 认证、Key 列表和异步图像请求均由容器转发，浏览器无需跨域请求。
SUB2API_PROXY_ENABLED=true

# 由宿主机 Nginx/宝塔/1Panel 将工作台域名反代到 http://127.0.0.1:8081。
# 若反代在另一台机器或需要直接通过服务器 IP 访问，设置 BIND_ADDRESS=0.0.0.0。
BIND_ADDRESS=127.0.0.1
WEB_PORT=8081
